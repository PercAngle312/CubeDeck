@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "Core/HW/EXI/EXI_Device.h"
+#include "Core/HW/EXI/SD2SP2SPI.h"
+namespace ExpansionInterface {
+class CEXISD2SP2 final : public IEXIDevice {
+public:
+  CEXISD2SP2(Core::System& system, const std::string& path);
+  void ImmReadWrite(u32& data, u32 size) override;
+  bool IsPresent() const override { return m_card.present(); }
+  void SetCS(int cs) override { if (!cs) m_card.deselect(); }
+private:
+  void TransferByte(u8& byte) override;
+  cubedeck::SD2SP2SPI m_card;
+};
+}
