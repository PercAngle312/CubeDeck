diff --git a/Source/Core/Core/HW/EXI/EXI_DeviceSD2SP2.cpp b/Source/Core/Core/HW/EXI/EXI_DeviceSD2SP2.cpp
new file mode 100644
index 0000000..b1dad6c
--- /dev/null
+++ b/Source/Core/Core/HW/EXI/EXI_DeviceSD2SP2.cpp
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "Core/HW/EXI/EXI_DeviceSD2SP2.h"
+#include "Common/Logging/Log.h"
+namespace ExpansionInterface {
+CEXISD2SP2::CEXISD2SP2(Core::System& system, const std::string& path)
+    : IEXIDevice(system), m_card(path) {
+  INFO_LOG_FMT(EXPANSIONINTERFACE, "CubeDeck read-only SD2SP2 image present={}", m_card.present());
+}
+void CEXISD2SP2::ImmReadWrite(u32& value, u32 size) {
+  u32 reply = 0;
+  for (u32 i = 0; i < size; ++i) {
+    u8 byte = value >> (24 - i * 8);
+    TransferByte(byte);
+    reply |= u32(byte) << (24 - i * 8);
+  }
+  value = reply;
+}
+void CEXISD2SP2::TransferByte(u8& byte) {
+  const auto before = m_card.commands;
+  byte = m_card.transfer(byte);
+  if (before != m_card.commands)
+    INFO_LOG_FMT(EXPANSIONINTERFACE, "SD2SP2 CMD{} arg={} reads={} denied={}",
+                 m_card.last_command, m_card.last_argument, m_card.reads,
+                 m_card.rejected_writes);
+}
+}
diff --git a/Source/Core/Core/HW/EXI/EXI_DeviceSD2SP2.h b/Source/Core/Core/HW/EXI/EXI_DeviceSD2SP2.h
